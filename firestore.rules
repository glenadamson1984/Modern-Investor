rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is admin
    function isAdmin() {
      return request.auth != null && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    // Users collection - users can read their own data, admins can read all
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow write: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
      // Admins can update any user's role
      allow update: if request.auth != null && (request.auth.uid == userId || isAdmin());
    }
    
    // Performance collection - public read for now, authenticated write
    match /performance/{performanceId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Trades collection - authenticated read/write
    match /trades/{tradeId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Courses collection - authenticated read, authenticated write
    match /courses/{courseId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Bookings collection - users can read/write their own
    match /bookings/{bookingId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
      allow create: if request.auth != null;
    }
    
    // Articles collection - public read, authenticated write
    match /articles/{articleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Predictions collection - authenticated read/write
    match /predictions/{predictionId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}
